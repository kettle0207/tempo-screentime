{
  "manifest_version": 3,
  "name": "Tempo · サイト別の使用時間",
  "description": "操作中のタブのドメインを、この PC の Tempo に渡します。",
  "version": "1.3.0",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "105"
}
